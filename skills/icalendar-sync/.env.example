# iCalendar Sync Configuration
# Copy to ~/.openclaw/.env and fill in your credentials

# Your iCloud Apple ID email
ICLOUD_USERNAME="your@icloud.com"

# App-Specific Password (NOT your regular Apple ID password)
# Get it from: https://appleid.apple.com -> App-Specific Passwords
ICLOUD_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Optional: Default calendar name
DEFAULT_CALENDAR="Personal"

# Optional: Logging level
LOG_LEVEL="INFO"