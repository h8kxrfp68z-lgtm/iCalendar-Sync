# ClawHub Skill Manifest v1.0
# This is the AUTHORITATIVE metadata file for ClawHub registry

[skill]
name = "icalendar-sync"
version = "2.2.20"
type = "runtime"
instruction_only = false

[install]
type = "script"
script = "install.sh"
has_install_spec = true

[environment.required]
ICLOUD_USERNAME = { description = "Apple ID email address", required = true, sensitive = false }
ICLOUD_APP_PASSWORD = { description = "App-Specific Password from appleid.apple.com", required = true, sensitive = true }

[environment.optional]
DEFAULT_CALENDAR = { description = "Default calendar name", default = "Personal" }
LOG_LEVEL = { description = "Logging level", default = "INFO" }
